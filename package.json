{
  "name": "markgraf-www",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "spago build && bun run gen-routes && bun run fonts && bun run scripts/dev.mjs",
    "build": "spago build && bun run gen-routes && bun run worker && bun run fonts && next build",
    "start": "next start",
    "worker": "bun run scripts/build-diagram-shapes-worker.mjs",
    "fonts": "bun -e 'import(\"./output/Build.SubsetFonts/index.js\").then((m) => m.main())'",
    "preview:noscript": "bun run scripts/noscript-preview.mjs",
    "gen-routes": "PURESCRIPT_RSC_ROOT=\"$PWD\" purs-rsc-routes",
    "postinstall": "node scripts/patch-next-purs-rsc.mjs"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@markgrafhq/markgraf-embed": "0.1.25",
    "@markgrafhq/markgraf-react": "0.1.22",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/offscreen": "^0.0.8",
    "@uiw/react-codemirror": "^4.25.10",
    "motion": "^12.40.0",
    "next": "^16.2.9",
    "next-purs-rsc": "^0.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.184.0",
    "unplugin": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "26.0.0",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.15",
    "purescript": "^0.15.16",
    "purs-backend-es": "^1.4.3",
    "spago": "^1.0.4",
    "subset-font": "^2.5.0",
    "tailwindcss": "^4.3.1",
    "typescript": "6.0.3"
  }
}
