onospace; background: #000; color: #ff3300;\n    border: 3px inset #808080; padding: 2px 6px; letter-spacing: 4px; font-weight: bold; }\n  .nsf-new { color: #ff0000; font-weight: bold; font-family: \"Courier New\", monospace; }\n  .nsf-title { font-size: 42px; font-weight: bold; letter-spacing: -1px; }\n  /* The graph diagram, rendered the 1996 way: a table whose edge cells morph\n     between a ring and a star by toggling visibility. No JavaScript, no SVG —\n     just CSS keyframes flipping opacity on <td> contents. */\n  .nsf-graph { border-collapse: collapse; margin: 4px auto; background: #000;\n    border: 3px ridge #c0c0c0; }\n  .nsf-graph td { width: 34px; height: 34px; padding: 0; text-align: center;\n    vertical-align: middle; font-family: \"Courier New\", monospace; font-size: 22px;\n    line-height: 34px; color: #00ffaa; }\n  .nsf-node { display: inline-block; width: 24px; height: 24px; line-height: 21px;\n    border: 2px solid #ffff00; border-radius: 50%; background: #113300; color: #ffff00;\n    font-weight: bold; font-size: 14px; }\n  .nsf-core { animation: nsf-core 4s ease-in-out infinite; }\n  .nsf-ring-edge { animation: nsf-ring 4s ease-in-out infinite; }\n  .nsf-star-edge { animation: nsf-star 4s ease-in-out infinite; color: #ff66ff; }\n  @keyframes nsf-ring { 0%,42% { opacity: 1; } 50%,92% { opacity: 0; } 100% { opacity: 1; } }\n  @keyframes nsf-star { 0%,42% { opacity: 0; } 50%,92% { opacity: 1; } 100% { opacity: 0; } }\n  @keyframes nsf-core { 0%,42% { box-shadow: none; border-color: #ffff00; }\n    50%,92% { box-shadow: 0 0 10px #ff66ff; border-color: #ff66ff; } 100% { box-shadow: none; } }\n</style>\n\n<center>\n\n<marquee behavior=\"alternate\" scrollamount=\"14\" bgcolor=\"#000000\">\n  <font size=\"5\" color=\"#ffff00\" face=\"Comic Sans MS\">&#9733;&#9733;&#9733; WELCOME TO MARKGRAF.DEV &#9733;&#9733;&#9733; you are visitor number 0000042 &#9733;&#9733;&#9733; sign my guestbook!! &#9733;&#9733;&#9733;</font>\n</marquee>\n\n<table border=\"6\" cellpadding=\"14\" cellspacing=\"0\" bgcolor=\"#000000\" align=\"center\">\n  <tr><td align=\"center\">\n    <span class=\"nsf-rainbow nsf-title\">~* M A R K G R A F *~</span>\n  </td></tr>\n</table>\n\n<p>\n  <img alt=\"UNDER CONSTRUCTION\" width=\"270\" height=\"50\"\n       src=\"data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='270'%20height='50'%3E%3Cdefs%3E%3Cpattern%20id='h'%20width='28'%20height='50'%20patternUnits='userSpaceOnUse'%20patternTransform='skewX(-22)'%3E%3Crect%20width='14'%20height='50'%20fill='%23000'/%3E%3Crect%20x='14'%20width='14'%20height='50'%20fill='%23ffcc00'/%3E%3C/pattern%3E%3C/defs%3E%3Crect%20width='270'%20height='50'%20fill='url(%23h)'/%3E%3Crect%20x='34'%20y='12'%20width='202'%20height='26'%20fill='%23000'/%3E%3Ctext%20x='135'%20y='31'%20font-family='monospace'%20font-size='15'%20fill='%23ffcc00'%20text-anchor='middle'%3EUNDER%20CONSTRUCTION%3C/text%3E%3Ccircle%20cx='15'%20cy='25'%20r='7'%20fill='%23f00'%3E%3Canimate%20attributeName='opacity'%20values='1;0;1'%20dur='0.7s'%20repeatCount='indefinite'/%3E%3C/circle%3E%3Ccircle%20cx='255'%20cy='25'%20r='7'%20fill='%23f00'%3E%3Canimate%20attributeName='opacity'%20values='0;1;0'%20dur='0.7s'%20repeatCount='indefinite'/%3E%3C/circle%3E%3C/svg%3E\">\n</p>\n\n<h1 class=\"nsf-blink\"><font color=\"#ff2200\" face=\"Comic Sans MS\">&#128679; THIS SITE IS UNDER CONSTRUCTION &#128679;</font></h1>\n\n<hr class=\"nsf-rule\">\n\n<div class=\"nsf-card\">\n  <table class=\"nsf-graph\">\n    <tr>\n      <td><span class=\"nsf-node\">A</span></td>\n      <td><span class=\"nsf-ring-edge\">&#9472;</span></td>\n      <td><span class=\"nsf-ring-edge\">&#9472;</span></td>\n      <td><span class=\"nsf-ring-edge\">&#9472;</span></td>\n      <td><span class=\"nsf-node\">B</span></td>\n    </tr>\n    <tr>\n      <td><span class=\"nsf-ring-edge\">&#9474;</span></td>\n      <td><span class=\"nsf-star-edge\">&#9586;</span></td>\n      <td></td>\n      <td><span class=\"nsf-star-edge\">&#9585;</span></td>\n      <td><span class=\"nsf-ring-edge\">&#9474;</span></td>\n    </tr>\n    <tr>\n      <td><span class=\"nsf-ring-edge\">&#9474;</span></td>\n      <td></td>\n      <td><span class=\"nsf-node nsf-core\">E</span></td>\n      <td></td>\n      <td><span class=\"nsf-ring-edge\">&#9474;</span></td>\n    </tr>\n    <tr>\n      <td><span class=\"nsf-ring-edge\">&#9474;</span></td>\n      <td><span class=\"nsf-star-edge\">&#9585;</span></td>\n      <td></td>\n      <td><span class=\"nsf-star-edge\">&#9586;</span></td>\n      <td><span class=\"nsf-ring-edge\">&#9474;</span></td>\n    </tr>\n    <tr>\n      <td><span class=\"nsf-node\">C</span></td>\n      <td><span class=\"nsf-ring-edge\">&#9472;</span></td>\n      <td><span class=\"nsf-ring-edge\">&#9472;</span></td>\n      <td><span class=\"nsf-ring-edge\">&#9472;</span></td>\n      <td><span class=\"nsf-node\">D</span></td>\n    </tr>\n  </table>\n  <font color=\"#00ffaa\" face=\"Courier New\" size=\"2\">fig. 1 &mdash; one (1) animated graph diagram, hand-cranked in HTML tables</font>\n  <hr class=\"nsf-rule\">\n  <font color=\"#ffffff\" face=\"Times New Roman\" size=\"4\">\n    JavaScript is switched off, so the real diagrams &mdash; <i>short animated graphs\n    from a tiny declarative source language</i>, live in WebGL &mdash; can't run.\n    What you see above is the closest 1996 could get.<br><br>\n    <span class=\"nsf-blink nsf-new\">&lt;TURN JAVASCRIPT ON&gt;</span> for the real thing.\n  </font>\n</div>\n\n<marquee behavior=\"scroll\" direction=\"left\" scrollamount=\"6\">\n  <font color=\"#00ffff\" face=\"Courier New\">\n    &#9658; best viewed in Netscape Navigator 4.0 at 800x600 &#9658; please turn on your speakers for the MIDI &#9658; this page is Y2K compliant &#9658;\n  </font>\n</marquee>\n\n<hr class=\"nsf-rule\">\n\n<table cellpadding=\"6\" align=\"center\"><tr>\n  <td><font color=\"#c0c0c0\" face=\"Courier New\" size=\"2\">visitors since 1996:</font></td>\n  <td><span class=\"nsf-counter\">0&nbsp;0&nbsp;0&nbsp;0&nbsp;0&nbsp;4&nbsp;2</span></td>\n</tr></table>\n\n<p>\n  <font face=\"Courier New\" color=\"#ffcc00\" size=\"2\">\n    [ <a href=\"mailto:hello@markgraf.dev\">&#9993; e-mail the webmaster</a> ]\n    &nbsp;&middot;&nbsp;\n    [ <a href=\"#\">&#9758; sign my guestbook</a> ]\n    &nbsp;&middot;&nbsp;\n    [ <a href=\"#\">join the WEBRING</a> &#9756; ]\n  </font>\n</p>\n\n<hr class=\"nsf-rule\">\n\n<p><font face=\"Comic Sans MS\" color=\"#888888\" size=\"2\">\n  &copy; 1996&ndash;2026 markgraf &middot; hand-coded in Notepad\n</font></p>\n\n</center>\n"}},"identifier":"retro"},{"annotation":{"meta":null,"sourceSpan":{"end":[25,24],"start":[25,1]}},"bindType":"NonRec","expression":{"abstraction":{"abstraction":{"annotation":{"meta":{"metaType":"IsForeign"},"sourceSpan":{"end":[26,41],"start":[26,20]}},"type":"Var","value":{"identifier":"createBuiltinElement_","moduleName":["Yoga","React","DOM","Internal"]}},"annotation":{"meta":null,"sourceSpan":{"end":[26,52],"start":[26,20]}},"argument":{"annotation":{"meta":null,"sourceSpan":{"end":[26,52],"start":[26,42]}},"type":"Literal","value":{"literalType":"StringLiteral","value":"noscript"}},"type":"App"},"annotation":{"meta":null,"sourceSpan":{"end":[26,114],"start":[26,20]}},"argument":{"abstraction":{"annotation":{"meta":{"metaType":"IsForeign"},"sourceSpan":{"end":[26,66],"start":[26,54]}},"type":"Var","value":{"identifier":"unsafeCoerce","moduleName":["Unsafe","Coerce"]}},"annotation":{"meta":null,"sourceSpan":{"end":[26,113],"start":[26,54]}},"argument":{"annotation":{"meta":null,"sourceSpan":{"end":[26,113],"start":[26,67]}},"type":"Literal","value":{"literalType":"ObjectLiteral","value":[["dangerouslySetInnerHTML",{"annotation":{"meta":null,"sourceSpan":{"end":[26,111],"start":[26,94]}},"type":"Literal","value":{"literalType":"ObjectLiteral","value":[["__html",{"annotation":{"meta":null,"sourceSpan":{"end":[26,109],"start":[26,104]}},"type":"Var","value":{"identifier":"retro","moduleName":["